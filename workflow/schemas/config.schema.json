{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ENCODE-style Pipeline Config",
  "type": "object",
  "required": ["samples", "genome_resources"],
  "properties": {
    "samples": {
      "type": "string",
      "description": "Path to sample sheet (TSV format)."
    },
    "outdir": {
      "type": "string",
      "default": "results",
      "description": "Output directory for all pipeline results."
    },
    "threads": {
      "type": "integer",
      "minimum": 1,
      "default": 8,
      "description": "CPU threads per job."
    },
    "mapq": {
      "type": "integer",
      "minimum": 0,
      "default": 30,
      "description": "MAPQ filter threshold for samtools view -q."
    },
    "binsize": {
      "type": "integer",
      "minimum": 1,
      "default": 10,
      "description": "BigWig bin size in bp."
    },
    "config_schema_version": {
      "type": "string",
      "enum": ["1.0.0", "2.0.0"],
      "default": "1.0.0",
      "description": "Config compatibility version; omitted legacy YAML resolves to 1.0.0."
    },
    "analysis_profile": {
      "type": "string",
      "enum": ["legacy", "updated"],
      "default": "legacy",
      "description": "Analysis policy bundle; updated must be explicit."
    },
    "blacklist_mode": {
      "type": "string",
      "enum": ["off", "copies", "analysis"],
      "default": "copies",
      "description": "off=raw; copies=QC copies; analysis=filtered analysis branch (updated only)."
    },
    "organelle_mode": {
      "type": "string",
      "enum": ["auto", "exclude", "report", "keep"],
      "default": "keep"
    },
    "duplicate_backend": {
      "type": "string",
      "enum": ["", "picard", "samtools"],
      "default": ""
    },
    "duplicate_analysis": {
      "type": "string",
      "enum": ["auto", "exclude", "retain"],
      "default": "auto"
    },
    "control_mode": {
      "type": "string",
      "enum": ["matched", "pooled", "auto"],
      "default": "pooled"
    },
    "reference_mode": {
      "type": "string",
      "enum": ["legacy", "strict"],
      "default": "legacy"
    },
    "external_control_policy": {
      "type": "string",
      "enum": ["warn", "validate"],
      "default": "warn"
    },
    "fragment_cpm": {
      "type": "string",
      "enum": ["off", "auto", "on"],
      "default": "off",
      "description": "Additive fragment-level CPM track; updated default auto, legacy requires off."
    },
    "tss_fragment_profile": {
      "type": "boolean",
      "default": false,
      "description": "Opt-in fragment-occupancy TSS profile; requires fragment_cpm != off and a GTF."
    },
    "remove_dup": {
      "type": "string",
      "enum": ["auto", "yes", "no"],
      "default": "auto",
      "description": "Duplicate removal policy."
    },
    "trim": {
      "type": ["boolean", "string"],
      "default": true,
      "description": "Enable adapter/quality trimming with Trim Galore."
    },
    "extend_reads": {
      "type": "string",
      "default": "auto",
      "description": "Read extension policy for bamCoverage."
    },
    "use_control": {
      "type": ["boolean", "string"],
      "default": false,
      "description": "Enable optional control/input support."
    },
    "multiqc": {
      "type": ["boolean", "string"],
      "default": true,
      "description": "Run MultiQC aggregation after all samples complete."
    },
    "replicate_analysis": {
      "type": ["boolean", "string"],
      "default": true,
      "description": "Enable replicate-aware grouped outputs."
    },
    "chipseq_idr": {
      "type": ["boolean", "string"],
      "default": false,
      "description": "Enable TF ChIP-seq IDR."
    },
    "idr": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "seed": { "type": "integer" },
        "threshold": { "type": "number" },
        "rank": { "type": "string" }
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": ["boolean", "string"] },
        "consensus": { "type": "object", "additionalProperties": true },
        "idr": { "type": "object", "additionalProperties": true }
      }
    },
    "cuttag": {
      "type": "object",
      "additionalProperties": true
    },
    "mnase": {
      "type": "object",
      "additionalProperties": true
    },
    "tool_parameters": {
      "type": "object",
      "additionalProperties": true
    },
    "qc": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "blacklist_filter": { "type": ["boolean", "string"], "default": true },
        "frip": { "type": ["boolean", "string"], "default": true },
        "library_complexity": { "type": ["boolean", "string"], "default": true },
        "nrf_pbc": { "type": ["boolean", "string"], "default": true },
        "signal_tracks": { "type": ["boolean", "string"], "default": true },
        "summary": { "type": ["boolean", "string"], "default": true },
        "cuttag_fragment_size": { "type": ["boolean", "string"], "default": true },
        "cross_correlation": { "type": ["boolean", "string"], "default": false },
        "preseq_complexity": { "type": ["boolean", "string"], "default": false },
        "picard_metrics": { "type": ["boolean", "string"], "default": false },
        "tss_enrichment": { "type": ["boolean", "string"], "default": false }
      }
    },
    "genome_resources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["effective_genome_size"],
        "properties": {
          "effective_genome_size": {
            "oneOf": [
              { "type": "string", "enum": ["hs", "mm"] },
              { "type": "integer", "minimum": 1 }
            ]
          },
          "chrom_sizes": { "type": "string" },
          "blacklist": { "type": "string" },
          "gtf": { "type": "string" },
          "reference_fasta": { "type": "string" },
          "organelle_chroms": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
