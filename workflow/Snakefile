configfile: "config/config.yaml"


# Phase 0: activate Snakemake-native schema validation. The existing
# config.schema.yaml is a human-readable contract; the runtime schema is
# workflow/schemas/config.schema.json (JSON Schema). The runtime schema is
# intentionally lenient (additionalProperties: true) so that the legacy
# validator remains the authoritative checker during transition.
schema: "schemas/config.schema.json"

VALIDATED_CONFIG = validate_config(config)
validate_execution_support(VALIDATED_CONFIG)

RAW_OUTDIR = VALIDATED_CONFIG["outdir"]
BLACKLIST_MODE = VALIDATED_CONFIG.get("blacklist_mode", "off")
