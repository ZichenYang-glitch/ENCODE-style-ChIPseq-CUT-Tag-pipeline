        for sid in TREATMENT_SAMPLE_IDS
        if SAMPLE_MAP[sid]["assay"] == "cuttag" and SAMPLE_MAP[sid]["layout"] == "PE"
    ]
else:
    SEACR_SAMPLE_IDS = []

if SEACR_ENABLED and not SEACR_SAMPLE_IDS:
    print(
        "Warning: cuttag.seacr.enabled is true but no PE CUT&Tag treatment "
        "sample is eligible; no SEACR output will be produced.",
        file=sys.stderr,
    )

