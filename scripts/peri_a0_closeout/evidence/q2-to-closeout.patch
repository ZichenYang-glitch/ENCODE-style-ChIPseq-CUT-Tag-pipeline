+use std::sync::{
+    atomic::{AtomicU64, Ordering},
+    OnceLock,
+};
+static PREDICTION_ATTEMPTS: AtomicU64 = AtomicU64::new(0);
+static PREDICTION_STARTED: AtomicU64 = AtomicU64::new(0);
+static PREDICTION_SUPPRESSED: AtomicU64 = AtomicU64::new(0);
+
+fn parse_prediction_policy(raw: Option<&str>) -> Result<bool, &'static str> {
+    match raw {
+        None => Ok(true),
+        Some("off") => Ok(false),
+        _ => Err("invalid PERI_PREDICTION_POLICY"),
+    }
+}
+
+pub(super) fn prediction_enabled() -> Result<bool, &'static str> {
+    static POLICY: OnceLock<Result<bool, &'static str>> = OnceLock::new();
+    *POLICY.get_or_init(|| match std::env::var("PERI_PREDICTION_POLICY") {
+        Ok(raw) => parse_prediction_policy(Some(&raw)),
+        Err(std::env::VarError::NotPresent) => parse_prediction_policy(None),
+        Err(_) => Err("invalid PERI_PREDICTION_POLICY"),
+    })
+}
+
+pub(super) fn policy_facts(
+    cfg: &AcpServerConfig,
+) -> Result<serde_json::Value, crate::transport::types::AcpError> {
+    let enabled = prediction_enabled()
+        .map_err(|message| crate::transport::types::AcpError::new(-32603, message))?;
+    let tools = peri_agent::session::tool_catalog::process_tool_policy_facts()
+        .map_err(|error| crate::transport::types::AcpError::new(-32603, error.to_string()))?;
+    let compact = cfg
+        .peri_config
+        .read()
+        .config
+        .compact
+        .clone()
+        .unwrap_or_default();
+    Ok(serde_json::json!({"version":1,"prediction_enabled":enabled,
+        "prediction_attempts":PREDICTION_ATTEMPTS.load(Ordering::SeqCst),
+        "prediction_started":PREDICTION_STARTED.load(Ordering::SeqCst),
+        "prediction_suppressed":PREDICTION_SUPPRESSED.load(Ordering::SeqCst),
+        "auto_compact_enabled":compact.auto_compact_enabled,"tool_policy":tools}))
+}
 
