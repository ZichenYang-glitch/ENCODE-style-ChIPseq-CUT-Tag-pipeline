+#[test]
+fn complete_process_policy_rejects_unknown_and_changed_generation_before_publication() {
+    let tool: Arc<dyn BaseTool> = Arc::new(BridgeTool::bridge("mcp__docs__lookup", "docs"));
+    let source = Arc::new(MutableCapability(parking_lot::RwLock::new(Arc::new(
+        SessionMcpCatalogSnapshot {
+            generation: 1,
+            tools: vec![tool.clone()],
+        },
+    ))));
+    let raw = serde_json::json!({"version":1,"tools":[{"name":tool.name(),"server":tool.mcp_server_name(),"wire":tool.mcp_tool_name(),"namespace":tool.namespace(),"builtin":null,"aliases":[],"parameters":tool.parameters()}]});
+    let policy = ProcessToolPolicy::parse(&raw.to_string()).unwrap();
+    let filter = policy.clone();
+    let mut catalog = SessionToolCatalog::try_with_filter(
+        BTreeMap::new(),
+        Some(source.clone()),
+        Arc::new(move |tool| filter.allows(tool)),
+    )
+    .unwrap();
+    catalog.strict_pinning = true;
+    catalog.required_policy = Some(policy.clone());
+    catalog.verify_complete(&catalog.snapshot()).unwrap();
+    let mut unknown = raw.clone();
+    unknown["tools"][0]["name"] = json!("does-not-exist");
+    assert!(ProcessToolPolicy::parse(&unknown.to_string())
+        .unwrap()
+        .verify_complete(&catalog.snapshot())
+        .is_err());
+    source.publish(SessionMcpCatalogSnapshot {
+        generation: 2,
+        tools: vec![],
+    });
+    assert!(matches!(
+        catalog.refresh(),
+        Err(CatalogRefreshError::RequiredPolicyIdentityUnavailable { .. })
+    ));
+    assert_eq!(catalog.snapshot().generation, 1);
+    source.publish(SessionMcpCatalogSnapshot {
+        generation: 3,
+        tools: vec![Arc::new(BridgeTool::bridge("mcp__docs__lookup", "other"))],
+    });
+    assert!(catalog.refresh().is_err());
+    assert_eq!(catalog.snapshot().generation, 1);
+    assert!(catalog.pin_working_tools(&BTreeMap::new()).is_err());
+    let mut wrong_schema = raw.clone();
+    wrong_schema["tools"][0]["parameters"] = json!({"type":"integer"});
+    assert!(ProcessToolPolicy::parse(&wrong_schema.to_string())
+        .unwrap()
+        .verify_complete(&catalog.snapshot())
+        .is_err());
+}
