@@ -12,11 +12,133 @@ use peri_acp_types::{
 
 use crate::tools::{BaseTool, ToolDefinition};
 
+/// Trusted process admission policy; deliberately independent of model/ACP settings.
+/// Unset preserves upstream behavior. Once read, policy cannot change within a process.
+#[derive(Clone, serde::Deserialize, serde::Serialize)]
+#[serde(deny_unknown_fields)]
+struct ProcessToolPolicy {
+    version: u32,
+    tools: Vec<ProcessToolIdentity>,
+}
+
+#[derive(Clone, serde::Deserialize, serde::Serialize)]
+#[serde(deny_unknown_fields)]
+struct ProcessToolIdentity {
+    name: String,
+    server: Option<String>,
+    wire: Option<String>,
+    namespace: Option<String>,
+    builtin: Option<String>,
+    aliases: Vec<String>,
+    parameters: Option<serde_json::Value>,
+}
+
+impl ProcessToolPolicy {
+    fn parse(raw: &str) -> Result<Self, CatalogRefreshError> {
+        if raw.len() > 16384 {
+            return Err(CatalogRefreshError::InvalidProcessPolicy);
+        }
+        let policy: Self =
+            serde_json::from_str(raw).map_err(|_| CatalogRefreshError::InvalidProcessPolicy)?;
+        let mut names = HashSet::new();
+        if raw.len() > 16384
+            || policy.version != 1
+            || policy.tools.len() > 32
+            || policy.tools.iter().any(|entry| {
+                entry.name.is_empty()
+                    || entry.name.contains('*')
+                    || !names.insert(entry.name.to_ascii_lowercase())
+                    || entry.server.is_some() != entry.wire.is_some()
+                    || entry
+                        .aliases
+                        .iter()
+                        .any(|alias| alias.is_empty() || alias.contains('*'))
+            })
+        {
+            return Err(CatalogRefreshError::InvalidProcessPolicy);
+        }
+        Ok(policy)
+    }
+
+    fn verify_complete(
+        &self,
+        snapshot: &SessionToolCatalogSnapshot,
+    ) -> Result<(), CatalogRefreshError> {
+        for entry in &self.tools {
+            let single = Self {
+                version: self.version,
+                tools: vec![entry.clone()],
+            };
+            if !snapshot
+                .tools
+                .values()
+                .any(|item| single.allows(item.tool.as_ref()))
+            {
+                return Err(CatalogRefreshError::RequiredPolicyIdentityUnavailable {
+                    name: entry.name.clone(),
+                });
+            }
+        }
+        Ok(())
+    }
+
+    fn allows(&self, tool: &dyn BaseTool) -> bool {
+        self.tools.iter().any(|entry| {
+            entry.name == tool.name()
+                && entry.server.as_deref() == tool.mcp_server_name()
+                && entry.wire.as_deref() == tool.mcp_tool_name()
+                && entry.namespace.as_deref() == tool.namespace()
+                && entry.builtin.as_deref() == tool.builtin_mcp_instance()
+                && entry
+                    .parameters
+                    .as_ref()
+                    .is_none_or(|schema| *schema == tool.parameters())
+                && entry
+                    .aliases
+                    .iter()
+                    .map(String::as_str)
+                    .eq(tool.aliases().iter().copied())
+        })
+    }
+}
+
+fn process_policy() -> Result<&'static Option<ProcessToolPolicy>, CatalogRefreshError> {
+    static POLICY: std::sync::OnceLock<Result<Option<ProcessToolPolicy>, CatalogRefreshError>> =
+        std::sync::OnceLock::new();
+    POLICY
+        .get_or_init(|| match std::env::var("PERI_PROCESS_TOOL_POLICY") {
+            Ok(raw) => ProcessToolPolicy::parse(&raw).map(Some),
+            Err(std::env::VarError::NotPresent) => Ok(None),
+            Err(_) => Err(CatalogRefreshError::InvalidProcessPolicy),
+        })
+        .as_ref()
+        .map_err(Clone::clone)
+}
+
+pub fn process_tool_policy_facts() -> Result<serde_json::Value, CatalogRefreshError> {
+    Ok(serde_json::to_value(process_policy()?).expect("policy serialization"))
+}
+
+pub(crate) fn process_tool_filter() -> Result<ToolFilter, CatalogRefreshError> {
+    let policy = process_policy()?;
+    Ok(Arc::new(move |tool| {
+        policy.as_ref().is_none_or(|policy| policy.allows(tool))
+    }))
+}
+
+pub(crate) fn strict_process_policy() -> bool {
+    process_policy().map_or(true, Option::is_some)
+}
