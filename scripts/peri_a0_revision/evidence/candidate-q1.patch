+#[cfg(test)]
+mod process_policy_tests {
+    use super::*;
+    use async_trait::async_trait;
+    use crate::tools::ToolContext;
+
+    struct Fixture { server: Option<&'static str> }
+    #[async_trait]
+    impl BaseTool for Fixture {
+        fn name(&self) -> &str { "Allowed" }
+        fn description(&self) -> &str { "synthetic" }
+        fn parameters(&self) -> serde_json::Value { serde_json::json!({"type":"object"}) }
+        fn mcp_server_name(&self) -> Option<&str> { self.server }
+        fn mcp_tool_name(&self) -> Option<&str> { self.server.map(|_| "wire") }
+        async fn invoke(&self, _: serde_json::Value, _: ToolContext<'_>)
+            -> Result<String, Box<dyn std::error::Error + Send + Sync>> { panic!("not invoked") }
+    }
+    fn policy() -> ProcessToolPolicy {
+        ProcessToolPolicy::parse(r#"{"version":1,"tools":[{"name":"Allowed","server":"approved","wire":"wire","namespace":null,"builtin":null,"aliases":[]}]}"#).unwrap()
+    }
+    #[test]
+    fn process_policy_rejects_unknown_version_fields_and_wildcards() {
+        for raw in [r#"{"version":2,"tools":[]}"#, r#"{"version":1,"tools":[],"bypass":true}"#,
+            r#"{"version":1,"tools":[{"name":"*","aliases":[]}]}"#] {
+            assert!(ProcessToolPolicy::parse(raw).is_err());
+        }
+    }
+    #[test]
+    fn process_policy_source_and_final_pin_are_not_name_only() {
+        let good: Arc<dyn BaseTool> = Arc::new(Fixture { server: Some("approved") });
+        let wrong: Arc<dyn BaseTool> = Arc::new(Fixture { server: Some("other") });
+        let intrinsic: Arc<dyn BaseTool> = Arc::new(Fixture { server: None });
+        let policy = policy();
+        assert!(policy.allows(good.as_ref()));
+        assert!(!policy.allows(wrong.as_ref()));
+        assert!(!policy.allows(intrinsic.as_ref()));
+        let catalog = SessionToolCatalog::try_with_filter(
+            BTreeMap::from([("Allowed".into(), good.clone())]), None,
+            Arc::new(move |tool| policy.allows(tool)),
+        ).unwrap();
+        assert_eq!(catalog.snapshot().tools.len(), 1);
+        assert_eq!(catalog.refresh().unwrap().tools.len(), 1);
+        let pin = catalog.pin_working_tools(&BTreeMap::from([("Allowed".into(), wrong)])).unwrap();
+        assert!(pin.tools.is_empty());
+        assert!(crate::tools::DirectToolInvocationResolver.resolve_target("Allowed", &pin.tool_map()).is_err());
+        assert!(crate::tools::DirectToolInvocationResolver.resolve_target("aLlOwEd", &pin.tool_map()).is_err());
+    }
