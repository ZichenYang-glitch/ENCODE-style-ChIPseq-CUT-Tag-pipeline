#!/usr/bin/python3 -I
"""Stable dispatcher for one fixed offline Bulk RNA-seq runtime operation."""

import hashlib
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import tempfile


REQUEST = Path("/run/helixweave/operator/bulk-runtime/request.json")
RECEIPT = Path("/run/helixweave/operator/bulk-runtime/receipt.json")
RELEASES = Path("/opt/helixweave/releases/platform")
REQUEST_SCHEMA = "helixweave-bulk-runtime-prepare-request-v2"
REQUEST_IDENTITY_SCHEME = "helixweave-bulk-runtime-prepare-request-identity-v2"
RECEIPT_SCHEMA = "helixweave-bulk-runtime-prepare-receipt-v2"
RECEIPT_IDENTITY_SCHEME = "helixweave-bulk-runtime-prepare-receipt-identity-v2"
IDENTITY = re.compile(r"sha256-[0-9a-f]{64}\Z")
TASK = re.compile(r"task-[0-9a-f]{32}\Z")
MAXIMUM = 1024 * 1024
MAXIMUM_IMAGES = 4096
ENVIRONMENT = {}


def _unique(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            raise ValueError
        value[key] = item
    return value


def _canonical(value):
    return (
        json.dumps(
            value,
            allow_nan=False,
            ensure_ascii=False,
            separators=(",", ":"),
            sort_keys=True,
        )
        + "\n"
    ).encode("utf-8")


def _identity(value, scheme):
    digest = hashlib.sha256()
    for item in (scheme.encode("ascii"), _canonical(value)):
        digest.update(len(item).to_bytes(8, byteorder="big", signed=False))
        digest.update(item)
    return "sha256-" + digest.hexdigest()


def _witness(value):
    return (
        value.st_dev,
        value.st_ino,
        value.st_mode,
        value.st_nlink,
        value.st_uid,
        value.st_gid,
        value.st_size,
        value.st_mtime_ns,
        value.st_ctime_ns,
    )


def _parse_request(content):
    value = json.loads(content, object_pairs_hook=_unique)
    required = {
        "schema_version",
        "identity",
        "operation",
        "component",
        "task_identity",
        "candidate_bulk_identity",
        "authority_platform_identity",
        "prior_state_identity",
        "candidate_state_identity",
        "docker_service_identity",
        "docker_client_identity",
        "docker_endpoint_identity",
        "docker_daemon_uid",
        "docker_daemon_gid",
    }
    identity_fields = (
        "identity",
        "candidate_bulk_identity",
        "authority_platform_identity",
        "prior_state_identity",
        "candidate_state_identity",
        "docker_service_identity",
        "docker_client_identity",
        "docker_endpoint_identity",
    )
    if (
        not isinstance(value, dict)
        or set(value) != required
        or value["schema_version"] != REQUEST_SCHEMA
        or value["operation"] not in {"activate", "rollback", "verify"}
        or value["component"] != "bulk-rnaseq-runtime"
        or not isinstance(value["task_identity"], str)
        or TASK.fullmatch(value["task_identity"]) is None
        or any(
            not isinstance(value[name], str) or IDENTITY.fullmatch(value[name]) is None
            for name in identity_fields
        )
        or any(
            not isinstance(value[name], int)
            or isinstance(value[name], bool)
            or not 0 <= value[name] <= 2**32 - 1
            for name in ("docker_daemon_uid", "docker_daemon_gid")
        )
        or value["identity"]
        != _identity(
            {name: item for name, item in value.items() if name != "identity"},
            REQUEST_IDENTITY_SCHEME,
        )
        or _canonical(value) != content
    ):
        raise ValueError
    return value


def _read_request():
    descriptor = os.open(
        REQUEST,
        os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0),
    )
    try:
        before = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_nlink != 1
            or before.st_uid != 0
            or before.st_gid != os.getegid()
            or stat.S_IMODE(before.st_mode) != 0o640
            or not 0 < before.st_size <= MAXIMUM
        ):
            raise OSError
        content = bytearray()
        while len(content) <= MAXIMUM:
            chunk = os.read(
                descriptor,
                min(65536, MAXIMUM + 1 - len(content)),
            )
            if not chunk:
                break
            content.extend(chunk)
        after = os.fstat(descriptor)
        at_path = REQUEST.stat(follow_symlinks=False)
        if (
            len(content) != before.st_size
            or len(content) > MAXIMUM
            or _witness(before) != _witness(after)
            or (after.st_dev, after.st_ino) != (at_path.st_dev, at_path.st_ino)
        ):
            raise OSError
    finally:
        os.close(descriptor)
    return _parse_request(bytes(content))


def _launcher(authority):
    release = RELEASES / authority
    payload = release / "payload"
    platform = payload / "platform"
    binary = platform / "bin" / "helixweave-service"
    for path, directory in (
        (RELEASES, True),
        (release, True),
        (payload, True),
        (platform, True),
        (platform / "bin", True),
        (binary, False),
    ):
        observed = path.stat(follow_symlinks=False)
        if (
            (
                stat.S_ISDIR(observed.st_mode)
                if directory
                else stat.S_ISREG(observed.st_mode)
            )
            is False
            or observed.st_uid != 0
            or observed.st_gid != 0
            or stat.S_IMODE(observed.st_mode) != 0o555
            or (not directory and observed.st_nlink != 1)
        ):
            raise OSError
    return binary


def _validate_receipt(content, request):
    value = json.loads(content, object_pairs_hook=_unique)
    required = {
        "schema_version",
        "identity",
        "status",
        "request_identity",
        "candidate_bulk_identity",
        "runtime_identity",
        "image_set_identity",
        "image_count",
    }
    identity_fields = (
        "identity",
        "request_identity",
        "candidate_bulk_identity",
        "runtime_identity",
        "image_set_identity",
    )
    if (
        not isinstance(value, dict)
        or set(value) != required
        or value["schema_version"] != RECEIPT_SCHEMA
        or value["status"] != "prepared"
        or any(
            not isinstance(value[name], str) or IDENTITY.fullmatch(value[name]) is None
            for name in identity_fields
        )
        or not isinstance(value["image_count"], int)
        or isinstance(value["image_count"], bool)
        or not 0 < value["image_count"] <= MAXIMUM_IMAGES
        or value["request_identity"] != request["identity"]
        or value["candidate_bulk_identity"] != request["candidate_bulk_identity"]
        or value["identity"]
        != _identity(
            {name: item for name, item in value.items() if name != "identity"},
            RECEIPT_IDENTITY_SCHEME,
        )
        or _canonical(value) != content
    ):
        raise ValueError


def _write_receipt(content):
    descriptor = os.open(
        RECEIPT,
        os.O_WRONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0),
    )
    try:
        before = os.fstat(descriptor)
        at_path = RECEIPT.stat(follow_symlinks=False)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_nlink != 1
            or before.st_uid != os.geteuid()
            or before.st_gid != os.getegid()
            or stat.S_IMODE(before.st_mode) != 0o600
            or before.st_size != 0
            or not 0 < len(content) <= MAXIMUM
            or (before.st_dev, before.st_ino) != (at_path.st_dev, at_path.st_ino)
        ):
            raise OSError
        offset = 0
        while offset < len(content):
            written = os.write(descriptor, content[offset:])
            if written <= 0:
                raise OSError
            offset += written
        os.fsync(descriptor)
        after = os.fstat(descriptor)
        if after.st_size != len(content) or (before.st_dev, before.st_ino) != (
            after.st_dev,
            after.st_ino,
        ):
            raise OSError
    finally:
        os.close(descriptor)


def main(argv=None):
    if tuple(sys.argv[1:] if argv is None else argv):
        return 64
    os.environ.clear()
    try:
        request = _read_request()
        launcher = _launcher(request["authority_platform_identity"])
        with tempfile.TemporaryFile() as output, tempfile.TemporaryFile() as errors:
            completed = subprocess.run(
                (str(launcher), "bulk-runtime-prepare"),
                stdin=subprocess.DEVNULL,
                stdout=output,
                stderr=errors,
                cwd="/",
                env=ENVIRONMENT,
                close_fds=True,
                timeout=14500,
                check=False,
            )
            if (
                completed.returncode != 0
                or errors.tell()
                or not 0 < output.tell() <= MAXIMUM
            ):
                return 69
            output.seek(0)
            content = output.read(MAXIMUM + 1)
        _validate_receipt(content, request)
        _write_receipt(content)
    except (
        OSError,
        ValueError,
        UnicodeError,
        json.JSONDecodeError,
        subprocess.SubprocessError,
    ):
        return 69
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
