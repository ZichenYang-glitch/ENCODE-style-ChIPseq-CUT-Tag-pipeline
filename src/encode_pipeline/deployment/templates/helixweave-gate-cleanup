#!/usr/bin/python3 -I
"""Fixed privileged Gate-cleanup entry; Phase A has no mutation backend."""

import hashlib
import json
import os
from pathlib import Path
import re
import stat
import sys


SCHEMA = "helixweave-deployment-gate-cleanup-receipt-v1"
TASK = re.compile(r"task-[0-9a-f]{32}\Z")
IDENTITY = re.compile(r"sha256-[0-9a-f]{64}\Z")
EXECUTOR = Path("/usr/libexec/helixweave-gate-cleanup")


def _valid(argv):
    return (
        len(argv) == 11
        and argv[0] == "cleanup"
        and argv[1] == "--task-id"
        and bool(TASK.fullmatch(argv[2]))
        and argv[3] == "--plan-id"
        and bool(IDENTITY.fullmatch(argv[4]))
        and argv[5] == "--executor-id"
        and bool(IDENTITY.fullmatch(argv[6]))
        and argv[7] == "--closure-id"
        and bool(IDENTITY.fullmatch(argv[8]))
        and argv[9] == "--backend-id"
        and bool(IDENTITY.fullmatch(argv[10]))
    )


def _file_identity(path):
    descriptor = None
    try:
        descriptor = os.open(
            path,
            os.O_RDONLY
            | getattr(os, "O_CLOEXEC", 0)
            | getattr(os, "O_NOFOLLOW", 0),
        )
        before = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_nlink != 1
            or before.st_uid != 0
            or before.st_gid != 0
            or stat.S_IMODE(before.st_mode) != 0o555
            or not 0 < before.st_size <= 1024 * 1024
        ):
            return None
        content = bytearray()
        while len(content) <= 1024 * 1024:
            chunk = os.read(descriptor, min(64 * 1024, 1024 * 1024 + 1 - len(content)))
            if not chunk:
                break
            content.extend(chunk)
        after = os.fstat(descriptor)
        def witness(value):
            return (
                value.st_dev,
                value.st_ino,
                value.st_mode,
                value.st_nlink,
                value.st_uid,
                value.st_gid,
                value.st_size,
                value.st_mtime_ns,
                value.st_ctime_ns,
            )
        if len(content) != before.st_size or witness(before) != witness(after):
            return None
        return f"sha256-{hashlib.sha256(content).hexdigest()}"
    except OSError:
        return None
    finally:
        if descriptor is not None:
            os.close(descriptor)


def _installed_identities():
    try:
        selected = Path(__file__).resolve(strict=True)
        closure = selected.parents[1].name
        expected = Path("/opt/helixweave/operator") / closure / "bin" / selected.name
        if selected != expected or not IDENTITY.fullmatch(closure):
            return None
        executor_identity = _file_identity(EXECUTOR)
        backend_identity = _file_identity(selected)
    except (OSError, IndexError):
        return None
    if executor_identity is None or backend_identity is None:
        return None
    return executor_identity, closure, backend_identity


def _write(code, message):
    value = {
        "schema_version": SCHEMA,
        "status": "error",
        "issue": {"code": code, "message": message},
    }
    sys.stderr.write(json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n")
    sys.stderr.flush()


def main(argv=None):
    values = tuple(sys.argv[1:] if argv is None else argv)
    os.environ.clear()
    os.environ.update(
        {
            "LANG": "C.UTF-8",
            "LC_ALL": "C.UTF-8",
            "PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
        }
    )
    if os.geteuid() != 0:
        _write(
            "GATE_CLEANUP_PRIVILEGE_REQUIRED",
            "Gate cleanup helper must run as root.",
        )
        return 77
    if not _valid(values):
        _write("GATE_CLEANUP_REQUEST_INVALID", "Gate cleanup request is invalid.")
        return 64
    if _installed_identities() != (values[6], values[8], values[10]):
        _write(
            "GATE_CLEANUP_EXECUTOR_MISMATCH",
            "Gate cleanup executor identity does not match.",
        )
        return 65
    _write(
        "GATE_CLEANUP_BACKEND_UNAVAILABLE",
        "Gate cleanup backend is not installed.",
    )
    return 69


if __name__ == "__main__":
    raise SystemExit(main())
