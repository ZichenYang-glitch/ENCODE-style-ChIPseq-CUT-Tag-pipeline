#!/usr/bin/python3 -I
"""Stable API/worker dispatcher into the root-owned active platform payload."""

import os
import hashlib
import json
from pathlib import Path
import re
import stat
import sys


IDENTITY = re.compile(r"sha256-[0-9a-f]{64}\Z")
RELEASES = Path("/opt/helixweave/releases/platform")
STATE_CURRENT = Path("/var/lib/helixweave/deployment/current")
STATE_SCHEME = "helixweave-deployment-state-identity-v1"
STATE_KEYS = {"schema_version", "identity", "generation", "created_at", "components"}
COMPONENTS = ("platform", "encode-runtime", "bulk-rnaseq-runtime")
ENVIRONMENT_KEYS = (
    "ENCODE_PIPELINE_DATABASE_URL",
    "ENCODE_PIPELINE_WORKSPACE_ROOT",
    "ENCODE_PIPELINE_REDIS_URL",
    "ENCODE_PIPELINE_QUEUE_NAME",
    "ENCODE_PIPELINE_REFERENCE_PROFILE_CONFIG",
    "ENCODE_PIPELINE_REDIS_CONNECT_TIMEOUT_SECONDS",
    "ENCODE_PIPELINE_REDIS_API_READ_TIMEOUT_SECONDS",
    "HELIXWEAVE_ENCODE_RUNTIME_ROOT",
    "HELIXWEAVE_ENCODE_RUNNER_ROOT",
    "HELIXWEAVE_ENCODE_CONDA_PREFIX",
    "HELIXWEAVE_DEPLOYMENT_IDENTITY",
    "HELIXWEAVE_ACTIVE_PLATFORM_IDENTITY",
    "HELIXWEAVE_ACTIVE_API_CONTRACT_SHA256",
    "HELIXWEAVE_BULK_RNASEQ_RUNTIME_ROOT",
    "ENCODE_PIPELINE_MANAGED_DOCKER_EXECUTABLE",
    "ENCODE_PIPELINE_MANAGED_DOCKER_SOCKET",
)


def _read_file(directory, name, mode, gid, maximum):
    descriptor = os.open(
        name,
        os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0),
        dir_fd=directory,
    )
    try:
        before = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_nlink != 1
            or before.st_uid != 0
            or before.st_gid != gid
            or stat.S_IMODE(before.st_mode) != mode
            or not 0 < before.st_size <= maximum
        ):
            raise OSError
        content = bytearray()
        while len(content) <= maximum:
            chunk = os.read(descriptor, min(65536, maximum + 1 - len(content)))
            if not chunk:
                break
            content.extend(chunk)
        after = os.fstat(descriptor)
        at_path = os.stat(name, dir_fd=directory, follow_symlinks=False)
        if (
            len(content) != before.st_size
            or len(content) > maximum
            or _witness(before) != _witness(after)
            or (after.st_dev, after.st_ino) != (at_path.st_dev, at_path.st_ino)
        ):
            raise OSError
    finally:
        os.close(descriptor)
    return bytes(content)


def _unique_object(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            raise ValueError
        value[key] = item
    return value


def _canonical(value):
    return (
        json.dumps(
            value,
            allow_nan=False,
            ensure_ascii=False,
            separators=(",", ":"),
            sort_keys=True,
        )
        + "\n"
    ).encode("utf-8")


def _state_identity(value):
    document = {key: item for key, item in value.items() if key != "identity"}
    digest = hashlib.sha256()
    for item in (STATE_SCHEME.encode("ascii"), _canonical(document)):
        digest.update(len(item).to_bytes(8, byteorder="big", signed=False))
        digest.update(item)
    return "sha256-" + digest.hexdigest()


def _parse_state(content, expected_identity):
    value = json.loads(content, object_pairs_hook=_unique_object)
    if (
        not isinstance(value, dict)
        or set(value) != STATE_KEYS
        or value["schema_version"] != "helixweave-deployment-state-v1"
        or value["identity"] != expected_identity
        or _state_identity(value) != expected_identity
        or _canonical(value) != content
        or not isinstance(value["generation"], int)
        or isinstance(value["generation"], bool)
        or value["generation"] < 0
        or not isinstance(value["created_at"], str)
        or not isinstance(value["components"], dict)
        or set(value["components"]) != set(COMPONENTS)
    ):
        raise ValueError
    for component in COMPONENTS:
        slots = value["components"][component]
        if not isinstance(slots, dict) or set(slots) != {"active", "previous", "staged"}:
            raise ValueError
        identities = tuple(slots[name] for name in ("active", "previous", "staged"))
        if any(
            item is not None
            and (not isinstance(item, str) or IDENTITY.fullmatch(item) is None)
            for item in identities
        ):
            raise ValueError
        selected = tuple(item for item in identities if item is not None)
        if len(selected) != len(set(selected)):
            raise ValueError
    active = {
        component: value["components"][component]["active"] for component in COMPONENTS
    }
    platform = active["platform"]
    if not isinstance(platform, str) or IDENTITY.fullmatch(platform) is None:
        raise ValueError
    return active


def _parse_environment(content, expected_state, active):
    if not content.endswith(b"\n"):
        raise ValueError
    values = {}
    observed_keys = []
    for raw in content.decode("ascii").splitlines():
        key, separator, value = raw.partition("=")
        if separator != "=" or not key or key in values or "\x00" in value:
            raise ValueError
        observed_keys.append(key)
        values[key] = value
    api_digest = values.get("HELIXWEAVE_ACTIVE_API_CONTRACT_SHA256", "")
    encode_identity = active["encode-runtime"]
    bulk_identity = active["bulk-rnaseq-runtime"]
    encode_root = ""
    runner_root = ""
    conda_prefix = ""
    if encode_identity is not None:
        encode_root = (
            "/opt/helixweave/runtimes/encode/"
            + encode_identity
            + "/payload/contracts/encode-runtime"
        )
        materialized = "/var/lib/helixweave/scientific/encode/" + encode_identity
        runner_root = materialized + "/runner"
        conda_prefix = materialized + "/conda-envs"
    bulk_root = ""
    if bulk_identity is not None:
        bulk_root = (
            "/opt/helixweave/runtimes/bulk-rnaseq/"
            + bulk_identity
            + "/payload/runtime"
        )
    expected = {
        "ENCODE_PIPELINE_DATABASE_URL": "sqlite:////var/lib/helixweave/database/live/platform.db",
        "ENCODE_PIPELINE_WORKSPACE_ROOT": "/var/lib/helixweave/workspaces",
        "ENCODE_PIPELINE_REDIS_URL": "unix:///run/helixweave/redis/redis.sock",
        "ENCODE_PIPELINE_QUEUE_NAME": "encode-runs",
        "ENCODE_PIPELINE_REFERENCE_PROFILE_CONFIG": "/etc/helixweave/reference-profiles.yaml",
        "ENCODE_PIPELINE_REDIS_CONNECT_TIMEOUT_SECONDS": "2",
        "ENCODE_PIPELINE_REDIS_API_READ_TIMEOUT_SECONDS": "5",
        "HELIXWEAVE_ENCODE_RUNTIME_ROOT": encode_root,
        "HELIXWEAVE_ENCODE_RUNNER_ROOT": runner_root,
        "HELIXWEAVE_ENCODE_CONDA_PREFIX": conda_prefix,
        "HELIXWEAVE_DEPLOYMENT_IDENTITY": expected_state,
        "HELIXWEAVE_ACTIVE_PLATFORM_IDENTITY": active["platform"],
        "HELIXWEAVE_ACTIVE_API_CONTRACT_SHA256": api_digest,
        "HELIXWEAVE_BULK_RNASEQ_RUNTIME_ROOT": bulk_root,
        "ENCODE_PIPELINE_MANAGED_DOCKER_EXECUTABLE": "/usr/bin/docker",
        "ENCODE_PIPELINE_MANAGED_DOCKER_SOCKET": "/run/helixweave/docker/docker.sock",
    }
    if (
        tuple(observed_keys) != ENVIRONMENT_KEYS
        or re.fullmatch(r"[0-9a-f]{64}", api_digest) is None
        or values != expected
    ):
        raise ValueError
    return values


def _active_generation():
    before = STATE_CURRENT.lstat()
    target = os.readlink(STATE_CURRENT)
    after = STATE_CURRENT.lstat()
    match = re.fullmatch(r"generations/(sha256-[0-9a-f]{64})", target)
    if (
        not stat.S_ISLNK(before.st_mode)
        or _witness(before) != _witness(after)
        or before.st_uid != 0
        or before.st_gid != 0
        or match is None
    ):
        raise OSError
    state_identity = match.group(1)
    generation = STATE_CURRENT.parent / target
    observed = generation.lstat()
    if (
        not stat.S_ISDIR(observed.st_mode)
        or stat.S_ISLNK(observed.st_mode)
        or observed.st_uid != 0
        or observed.st_gid != 0
        or stat.S_IMODE(observed.st_mode) != 0o555
    ):
        raise OSError
    directory = os.open(
        generation,
        os.O_RDONLY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_DIRECTORY", 0)
        | getattr(os, "O_NOFOLLOW", 0),
    )
    try:
        anchored = os.fstat(directory)
        if (anchored.st_dev, anchored.st_ino) != (observed.st_dev, observed.st_ino):
            raise OSError
        state = _read_file(directory, "deployment-state.json", 0o444, 0, 262144)
        active = _parse_state(state, state_identity)
        environment = _read_file(
            directory, "platform.env", 0o440, os.getegid(), 65536
        )
        values = _parse_environment(environment, state_identity, active)
    finally:
        os.close(directory)
    final_link = STATE_CURRENT.lstat()
    if _witness(before) != _witness(final_link) or os.readlink(STATE_CURRENT) != target:
        raise OSError
    return active["platform"], values


def _witness(value):
    return (
        value.st_dev,
        value.st_ino,
        value.st_mode,
        value.st_nlink,
        value.st_uid,
        value.st_gid,
        value.st_size,
        value.st_mtime_ns,
        value.st_ctime_ns,
    )


def _launcher(identity):
    release = RELEASES / identity
    payload = release / "payload"
    platform = payload / "platform"
    binary = platform / "bin" / "helixweave-service"
    for path, directory in (
        (RELEASES, True),
        (release, True),
        (payload, True),
        (platform, True),
        (platform / "bin", True),
        (binary, False),
    ):
        observed = path.stat(follow_symlinks=False)
        if (
            (
                stat.S_ISDIR(observed.st_mode)
                if directory
                else stat.S_ISREG(observed.st_mode)
            )
            is False
            or observed.st_uid != 0
            or observed.st_gid != 0
            or stat.S_IMODE(observed.st_mode) != 0o555
        ):
            raise OSError
    return binary


def main(argv=None):
    values = tuple(sys.argv[1:] if argv is None else argv)
    if len(values) != 1 or values[0] not in {"api", "worker"}:
        return 64
    try:
        platform_identity, platform_environment = _active_generation()
        binary = _launcher(platform_identity)
    except (OSError, ValueError, UnicodeError, json.JSONDecodeError):
        return 69
    environment = dict(os.environ)
    environment.update(platform_environment)
    environment["PYTHONNOUSERSITE"] = "1"
    os.execve(binary, (str(binary), values[0]), environment)
    return 70


if __name__ == "__main__":
    raise SystemExit(main())
