[Unit]
Description=HelixWeave supported single-host platform
Requires=helixweave-db-prepare.service helixweave-redis.service helixweave-api.service helixweave-worker.service
Wants=helixweave-docker-rootless.service
After=helixweave-db-prepare.service helixweave-redis.service

[Install]
WantedBy=multi-user.target
