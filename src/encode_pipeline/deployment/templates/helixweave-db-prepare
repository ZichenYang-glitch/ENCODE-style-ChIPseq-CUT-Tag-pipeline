#!/usr/bin/python3 -I
"""Unprivileged dispatcher for the post-backup candidate DB action."""

import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import tempfile


REQUEST = Path("/run/helixweave/database/prepare.json")
RECEIPT = Path("/run/helixweave/database/prepare-receipt.json")
RELEASES = Path("/opt/helixweave/releases/platform")
IDENTITY = re.compile(r"sha256-[0-9a-f]{64}\Z")
TASK = re.compile(r"task-[0-9a-f]{32}\Z")
HEAD = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,127}\Z")
MAXIMUM = 1024 * 1024
ENVIRONMENT = {
    "LANG": "C.UTF-8",
    "LC_ALL": "C.UTF-8",
    "PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
    "PYTHONNOUSERSITE": "1",
}


def _unique(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            raise ValueError
        value[key] = item
    return value


def _read_request():
    descriptor = os.open(
        REQUEST,
        os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0),
    )
    try:
        before = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_nlink != 1
            or before.st_uid != 0
            or before.st_gid != os.getegid()
            or stat.S_IMODE(before.st_mode) != 0o640
            or not 0 < before.st_size <= MAXIMUM
        ):
            raise OSError
        content = os.read(descriptor, MAXIMUM + 1)
        after = os.fstat(descriptor)
        if len(content) != before.st_size or (
            before.st_dev,
            before.st_ino,
            before.st_size,
            before.st_mtime_ns,
            before.st_ctime_ns,
        ) != (
            after.st_dev,
            after.st_ino,
            after.st_size,
            after.st_mtime_ns,
            after.st_ctime_ns,
        ):
            raise OSError
    finally:
        os.close(descriptor)
    value = json.loads(content, object_pairs_hook=_unique)
    required = {
        "schema_version",
        "identity",
        "operation",
        "component",
        "database_mode",
        "task_identity",
        "deployment_identity",
        "prior_state_identity",
        "candidate_state_identity",
        "action_receipt_identity",
        "backup_receipt_identity",
        "target_schema_heads",
    }
    heads = value.get("target_schema_heads") if isinstance(value, dict) else None
    if (
        not isinstance(value, dict)
        or set(value) != required
        or value["schema_version"] != "helixweave-database-prepare-request-v2"
        or value["operation"] not in {"activate", "rollback"}
        or value["component"] != "platform"
        or value["database_mode"] not in {"fresh-candidate", "existing-live"}
        or (
            value["database_mode"] == "fresh-candidate"
            and (
                value["operation"] != "activate"
                or value["backup_receipt_identity"] is not None
            )
        )
        or (
            value["database_mode"] == "existing-live"
            and value["backup_receipt_identity"] is None
        )
        or not isinstance(value["task_identity"], str)
        or TASK.fullmatch(value["task_identity"]) is None
        or any(
            not isinstance(value[name], str) or IDENTITY.fullmatch(value[name]) is None
            for name in (
                "identity",
                "deployment_identity",
                "prior_state_identity",
                "candidate_state_identity",
                "action_receipt_identity",
            )
        )
        or (
            value["backup_receipt_identity"] is not None
            and (
                not isinstance(value["backup_receipt_identity"], str)
                or IDENTITY.fullmatch(value["backup_receipt_identity"]) is None
            )
        )
        or not isinstance(heads, list)
        or not heads
        or heads != sorted(set(heads))
        or any(not isinstance(head, str) or HEAD.fullmatch(head) is None for head in heads)
        or json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
        != content
    ):
        raise ValueError
    return value


def _launcher(identity):
    release = RELEASES / identity
    payload = release / "payload"
    platform = payload / "platform"
    binary = platform / "bin" / "helixweave-service"
    for path, directory in (
        (RELEASES, True),
        (release, True),
        (payload, True),
        (platform, True),
        (platform / "bin", True),
        (binary, False),
    ):
        observed = path.stat(follow_symlinks=False)
        if (
            (stat.S_ISDIR(observed.st_mode) if directory else stat.S_ISREG(observed.st_mode))
            is False
            or observed.st_uid != 0
            or observed.st_gid != 0
            or stat.S_IMODE(observed.st_mode) != 0o555
        ):
            raise OSError
    return binary


def _write_receipt(content):
    descriptor = os.open(
        RECEIPT,
        os.O_WRONLY
        | os.O_TRUNC
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0),
    )
    try:
        observed = os.fstat(descriptor)
        if (
            not stat.S_ISREG(observed.st_mode)
            or observed.st_nlink != 1
            or observed.st_uid != os.geteuid()
            or observed.st_gid != os.getegid()
            or stat.S_IMODE(observed.st_mode) != 0o600
            or not 0 < len(content) <= MAXIMUM
        ):
            raise OSError
        offset = 0
        while offset < len(content):
            written = os.write(descriptor, content[offset:])
            if written <= 0:
                raise OSError
            offset += written
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def main(argv=None):
    if tuple(sys.argv[1:] if argv is None else argv):
        return 64
    os.environ.clear()
    os.environ.update(ENVIRONMENT)
    try:
        request = _read_request()
        launcher = _launcher(request["deployment_identity"])
        with tempfile.TemporaryFile() as output, tempfile.TemporaryFile() as errors:
            completed = subprocess.run(
                (str(launcher), "db-prepare"),
                stdin=subprocess.DEVNULL,
                stdout=output,
                stderr=errors,
                env=ENVIRONMENT,
                close_fds=True,
                timeout=240,
                check=False,
            )
            if completed.returncode != 0 or errors.tell() or not 0 < output.tell() <= MAXIMUM:
                return 69
            output.seek(0)
            content = output.read(MAXIMUM + 1)
        document = json.loads(content, object_pairs_hook=_unique)
        if json.dumps(document, sort_keys=True, separators=(",", ":")).encode() != content:
            return 65
        _write_receipt(content)
    except (OSError, ValueError, UnicodeError, json.JSONDecodeError, subprocess.SubprocessError):
        return 69
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
