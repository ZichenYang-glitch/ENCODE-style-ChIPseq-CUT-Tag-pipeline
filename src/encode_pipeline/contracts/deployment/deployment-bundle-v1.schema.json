{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helixweave.local/contracts/deployment-bundle-v1.schema.json",
  "title": "HelixWeave supported deployment bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "component",
    "contracts",
    "files"
  ],
  "properties": {
    "schema_version": {"const": "helixweave-deployment-bundle-v1"},
    "identity": {"$ref": "#/$defs/contentIdentity"},
    "component": {
      "enum": ["platform", "encode-runtime", "bulk-rnaseq-runtime"]
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/contractDocument"}
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/fileRecord"}
    }
  },
  "$defs": {
    "contentIdentity": {
      "type": "string",
      "pattern": "^sha256-[0-9a-f]{64}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contractToken": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:/+-]{0,191}$"
    },
    "payloadPath": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^payload/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._+@=-]+(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._+@=-]+)*$"
    },
    "contractPath": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^payload/contracts/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._+@=-]+(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._+@=-]+)*$"
    },
    "contractDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "identity", "path"],
      "properties": {
        "contract": {"$ref": "#/$defs/contractToken"},
        "identity": {"$ref": "#/$defs/contentIdentity"},
        "path": {"$ref": "#/$defs/contractPath"}
      }
    },
    "fileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256", "mode"],
      "properties": {
        "path": {"$ref": "#/$defs/payloadPath"},
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 107374182400
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "mode": {"enum": [292, 365]}
      }
    }
  }
}
