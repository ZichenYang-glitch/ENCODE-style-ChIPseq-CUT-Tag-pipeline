Bootstrap: docker
From: condaforge/miniforge3:24.11.3-0

%files
    workflow/envs/duplicate.lock /opt/pipeline/workflow/envs/duplicate.lock

%post
    conda create -n chipseq-duplicate --file /opt/pipeline/workflow/envs/duplicate.lock -y
    conda clean -afy

%environment
    export PATH=/opt/conda/envs/chipseq-duplicate/bin:$PATH
